# ── Required: NVIDIA NIM (LLM tier) ──────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Optional: model selection ────────────────────────────────────
# We run z-ai/glm-5.3 and meta/muse-glimmer-30b; code fallback when
# unset is meta/muse-glimmer-30b
AI_MODEL=
# Scoped alternatives, each with its own key:
KIMI_MODEL=
NVIDIA_KIMI_API_KEY=
MUSE_MODEL=
NVIDIA_MUSE_API_KEY=

# ── Optional: pipeline behavior ──────────────────────────────────
# 1 = LLM fills extraction blanks / unmatched classifications (default)
# 0 = fully deterministic, zero API calls
AI_FALLBACK=
# Hard cap on live (uncached) LLM calls per process (default 30)
AI_MAX_CALLS=
# Minimum calibrated confidence for the Laya System-1 neural tier to own a
# classification/intent decision (default 0.6). Requires `pip install laya`
# — the Modal deployment bakes it in; absent locally it degrades to
# rules -> LLM unchanged.
LAYA_MIN_CONFIDENCE=
# Gross-weight variance tolerance in percent; 0 (default) = exact match
WEIGHT_TOLERANCE_PCT=

# ── Optional: Supabase persistence ───────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: outbound email (Gmail SMTP) ────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_SENDER=

# ── Optional: inbound email polling (IMAP) ───────────────────────
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=

# ── Auto Email Getter: real-Gmail ingestion (LOCAL DEMO ONLY) ────
# 1 = enable IMAP/SMTP endpoints that read a real personal inbox.
# Keep 0/unset on any public deployment — it exposes mailbox content
# and lets anyone send mail via the stored SMTP credentials.
REAL_GMAIL_ENABLED=

# ── Deployment (set automatically by Render/Railway) ─────────────
PORT=
HOST=

# ── Frontend (set in frontend/.env or Vercel project env) ────────
# URL of the deployed backend, e.g. https://<service>.onrender.com
VITE_API_URL=
